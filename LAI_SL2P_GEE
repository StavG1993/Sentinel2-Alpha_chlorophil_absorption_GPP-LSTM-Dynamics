// ============================================================================
// Sentinel-2 LAI (SL2P / S2ToolBox Neural Network) in Google Earth Engine
// Collection: COPERNICUS/S2_SR_HARMONIZED
// Fixes: NO getInfo() inside any mapped function.
// ============================================================================


// ------------------ USER SETTINGS ------------------

var start = '2025-07-01';
var end   = '2025-07-10';
var cloudPct = 30;

// ------------------ SAVE / EXPORT OPTIONS ------------------
var SAVE_LAI = true;              // toggle ON/OFF
var EXPORT_MODE = 'COMPOSITE';    // 'COMPOSITE' or 'PER_IMAGE'
var COMPOSITE_REDUCER = 'MEAN'; // 'MEDIAN' or 'MEAN'

var EXPORT_SCALE = 10;            // recommended 20 m (inputs include 20 m bands)
var EXPORT_FOLDER = 'LAI_10m';
var EXPORT_PREFIX = 'LAI_SL2P_S2SR';

// ------------------ CLOUD MASK ------------------
function maskS2sr(img) {
  var scl = img.select('SCL');
  var sclMask = scl.eq(4).or(scl.eq(5)).or(scl.eq(6)).or(scl.eq(7));

  var qa = img.select('QA60');
  var cloudBitMask  = 1 << 10;
  var cirrusBitMask = 1 << 11;
  var qaMask = qa.bitwiseAnd(cloudBitMask).eq(0)
    .and(qa.bitwiseAnd(cirrusBitMask).eq(0));

  return img.updateMask(sclMask).updateMask(qaMask);
}

// ------------------ NN PARAMETERS (SL2P LAI / S2) ------------------
// 12 inputs order:
// B3, B4, B8, B5, B6, B7, B8A, B11, B12, cos(VZA), cos(SZA), cos(RAA)

var xmin = ee.Image.constant([
  0, 0, 0.023617798406067352, 0, 0.02202129476436714,
  0.0282828940537622, 0.027033167693721202, 0.008452168326508781, 0,
  0.9185974648964176, 0.3420445117819629, -0.9999999998938771
]);

var xmax = ee.Image.constant([
  0.24227150564744757, 0.29180643729483435, 0.7940468337225911, 0.3352184967986723,
  0.6082236185467771, 0.7593032519236953, 0.7762830093591506, 0.4951157687164573,
  0.4939202941174727, 0.9999999998075627, 0.9359109848078707, 0.9999999949266675
]);

// Hidden layer weights as ee.Image.constant vectors (12 weights each) + biases
var b1 = -1.2942679301598696;
var w1 = ee.Image.constant([-0.3742492703985799, -1.0879940321273938,  0.9073468650336846,  0.3615250088966526,
                            -3.118927273401686,   2.77498648736835,   -0.057300763562444526,-1.234084059620391,
                            -0.8564958529719705, -0.4841042554196577,  0.1515712348243339,  0.6152433844319842]);

var b2 =  0.8734788297065322;
var w2 = ee.Image.constant([ 0.44320224366190497, 0.8887592231132775, -0.5056153268593457,  0.9098195307014335,
                            -0.21344245581533045,-2.4093186017926205,  1.5692209777841764,  1.19567905031086,
                             0.08276325717685079,-0.10053882578929706,-0.3750623159288322, -0.023841736554610356]);

var b3 =  1.6077395606205696;
var w3 = ee.Image.constant([-0.04979059593238454, 0.05545236241312816,-2.050827282340712,  -0.038057479931813895,
                             2.7314636384400606,  0.0621089209933646, -2.520042453088982,   1.6787370971513154,
                             0.014589040863996896,-0.026092775177453207,0.004630525433094241,0.04475965644686002]);

var b4 = -0.7690197124128048;
var w4 = ee.Image.constant([-0.2809034831800579, -0.6919131312848309,  0.425638116628382,  -0.9578575668912771,
                             0.5258728878442835,  1.3642064064465487, -0.5814229260282106, -0.7416025252569921,
                            -0.21122777745932927, 0.1374457596308841,  0.3242486913111365, -0.04969549164971736]);

var b5 = -4.3601288190008844;
var w5 = ee.Image.constant([ 0.0326867623298655, -0.4572803297467024, -0.33274696775405693,-0.26145005507079555,
                             1.6331052298364763,  2.19881936121678,    0.06499309497213597, 0.2848516621138459,
                            -0.6458758003998314,  0.024346869568991975,-0.22837933063794427,-0.24834066469162608]);

// Output layer: y* = b + sum(vj * hj)
var W2b = 1.468201298006802;
var v  = ee.Image.constant([0.06116052624682594, 0.33858438067795643, -0.39458071876841083, 0.46139774610556217, 1.878696702247]);

var Ymin = 3.614536369589416e-05;
var Ymax = 14.238223860863263;

var Pmin = 0;
var Pmax = 8;

// ------------------ MATH HELPERS ------------------
function toRad(deg) { return ee.Number(deg).multiply(Math.PI).divide(180.0); }
function tansig(x) { return ee.Image(2).divide(ee.Image(1).add(x.multiply(-2).exp())).subtract(1); }

// ------------------ LAI NN FUNCTION (SERVER-SAFE) ------------------
function addLaiSl2p_S2SR(img) {

  // reflectance scaling
  var r = img.select(['B3','B4','B8','B5','B6','B7','B8A','B11','B12'])
    .multiply(0.0001);

  // angles (scene mean)
  var vza = ee.Number(img.get('MEAN_INCIDENCE_ZENITH_ANGLE_B8A'));
  var sza = ee.Number(img.get('MEAN_SOLAR_ZENITH_ANGLE'));
  var vaa = ee.Number(img.get('MEAN_INCIDENCE_AZIMUTH_ANGLE_B8A'));
  var saa = ee.Number(img.get('MEAN_SOLAR_AZIMUTH_ANGLE'));
  var raa = saa.subtract(vaa);

  var cosVZA = ee.Image.constant(toRad(vza).cos());
  var cosSZA = ee.Image.constant(toRad(sza).cos());
  var cosRAA = ee.Image.constant(toRad(raa).cos());

  // Build X in the expected order (12 vars)
  var X = r.addBands([cosVZA, cosSZA, cosRAA]).rename([
    'B3','B4','B8','B5','B6','B7','B8A','B11','B12','cosVZA','cosSZA','cosRAA'
  ]);

  // Normalize to [-1, 1]
  var Xn = X.subtract(xmin).divide(xmax.subtract(xmin)).multiply(2).subtract(1);

  // Convert 12-band image to a 12-element vector image (constant weights are 12-element vectors)
  // Dot product: sum(Xn_i * w_i)
  function neuron(Xn, w, b) {
    var dot = Xn.multiply(w).reduce('sum').add(b);
    return tansig(dot);
  }

  var n1 = neuron(Xn, w1, b1);
  var n2 = neuron(Xn, w2, b2);
  var n3 = neuron(Xn, w3, b3);
  var n4 = neuron(Xn, w4, b4);
  var n5 = neuron(Xn, w5, b5);

  var H = ee.Image.cat([n1, n2, n3, n4, n5]).rename(['n1','n2','n3','n4','n5']);

  // Output (linear)
  var yNorm = H.multiply(v).reduce('sum').add(W2b);

  // Denormalize to LAI
  var lai = yNorm.add(1).multiply(2).multiply(Ymax - Ymin).add(Ymin)
    .rename('LAI_SL2P')
    .clamp(Pmin, Pmax);

  // Force consistent 20 m grid (recommended)
  lai = lai.resample('bilinear')
           .reproject({crs: img.select('B8A').projection(), scale: EXPORT_SCALE});

  return img.addBands(lai);
}

// ------------------ BUILD COLLECTION ------------------
var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(roi)
  .filterDate(start, end)
  .filter(ee.Filter.lte('CLOUDY_PIXEL_PERCENTAGE', cloudPct))
  .map(maskS2sr)
  .map(addLaiSl2p_S2SR);

print('Number of images after filters:', s2.size());

// ------------------ COMPOSITE ------------------
var laiComp = ee.Image(
  (COMPOSITE_REDUCER === 'MEAN')
    ? s2.select('LAI_SL2P').mean()
    : s2.select('LAI_SL2P').mean()
).clip(roi);

// ------------------ MAP ------------------
Map.centerObject(roi, 12);
Map.addLayer(laiComp, {min: 0, max: 6}, 'LAI SL2P (composite)');

// ------------------ EXPORTS ------------------
if (SAVE_LAI && EXPORT_MODE === 'COMPOSITE') {

  Export.image.toDrive({
    image: laiComp,
    description: EXPORT_PREFIX + '_' + COMPOSITE_REDUCER + '_' + start + '_' + end,
    folder: EXPORT_FOLDER,
    fileNamePrefix: EXPORT_PREFIX + '_' + COMPOSITE_REDUCER + '_' + start + '_' + end,
    region: roi,
    scale: EXPORT_SCALE,
    maxPixels: 1e13
  });

} else if (SAVE_LAI && EXPORT_MODE === 'PER_IMAGE') {

  // Creates one export task per image (keep date windows reasonable)
  var list = s2.select('LAI_SL2P').toList(s2.size());
  var n = s2.size().getInfo(); // OK here (top-level client-side), not inside map()
  print('Creating export tasks for images:', n);

  for (var i = 0; i < n; i++) {
    var img = ee.Image(list.get(i)).clip(roi);
    var t = ee.Date(img.get('system:time_start')).format('YYYYMMdd_HHmmss').getInfo();

    Export.image.toDrive({
      image: img,
      description: EXPORT_PREFIX + '_' + t,
      folder: EXPORT_FOLDER,
      fileNamePrefix: EXPORT_PREFIX + '_' + t,
      region: roi,
      scale: EXPORT_SCALE,
      maxPixels: 1e13
    });
  }
}
